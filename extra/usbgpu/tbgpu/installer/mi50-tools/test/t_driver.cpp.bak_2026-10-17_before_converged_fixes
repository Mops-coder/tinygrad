    check(ra == 0 && cmd == want && (written ? g_cmdw_completes == c0 : g_cmdw_completes < 0) && g_completes == c0 + 2, m); };
  { uint16_t on = 0x0406, cmd; memcpy(pci->cfg + 4, &on, 2);   // each client's first call reads the entitlements current at that moment
    auto q = client(drv, ents(arr({"org.tinygrad.tinygpu.driver2"}))); kern_return_t r1 = call(q, QuiesceOnStop, {1});
    auto bad = client(drv, ents(nullptr)); kern_return_t r2 = call(bad, QuiesceOnStop, {});
    q->Stop_Impl(drv); bad->Stop_Impl(drv); memcpy(&cmd, pci->cfg + 4, 2);
    snprintf(m, sizeof m, "QuiesceOnStop with a scalar -> %#x, from an unentitled client -> %#x; neither arms it: PCI_COMMAND after both Stops %#x", r1, r2, cmd);
    check(r1 == kIOReturnBadArgument && r2 == kIOReturnNotPermitted && cmd == 0x0406, m); }
  quiesce_case(true, 0x0406, "armed, bus master on", 0x0402, true);
  quiesce_case(false, 0x0406, "not armed (stock client), bus master on", 0x0406, false);
  quiesce_case(true, 0xffff, "armed, config reads 0xffff (card gone)", 0xffff, false);
  quiesce_case(true, 0x0402, "armed, bus master already off", 0x0402, false);
  { uint16_t z = 0; memcpy(pci->cfg + 4, &z, 2); }
  // ---- NewUserClient: a created object that is not an IOUserClient is released and refused (stock leaked it and returned success) ----
  { IOUserClient* o = (IOUserClient*)0x1; g_create_kind = 0; kern_return_t r0 = drv->NewUserClient_Impl(0, &o);
    check(r0 == kIOReturnUnsupported, "NewUserClient: Create failing -> its error returned");
    o = (IOUserClient*)0x1; g_create_kind = 1; g_create_freed = 0; kern_return_t r1 = drv->NewUserClient_Impl(0, &o);
    snprintf(m, sizeof m, "NewUserClient: created object not an IOUserClient -> %#x, client %p, object released %d time(s)", r1, (void*)o, g_create_freed);
    check(r1 == kIOReturnError && o == nullptr && g_create_freed == 1, m);
    g_create_kind = 2; o = nullptr; kern_return_t r2 = drv->NewUserClient_Impl(0, &o);
    check(r2 == 0 && o && o->rc == 1, "NewUserClient: a user client -> success, handed to the caller with its one reference"); g_create_kind = 0; }
  // ---- driver Stop closes its provider (R2-12) ----
  drv->Stop_Impl(pci);
  check(pci->closes == 1, "driver Stop closes the PCI provider and calls the superclass Stop");
  auto drv2 = new TinyGPUDriver; drv2->init(); check(drv2->Stop_Impl(pci) == 0 && pci->closes == 1, "driver Stop without an opened provider -> no dereference, nothing closed");
  { auto pci3 = new IOPCIDevice; memcpy(pci3->cfg, &id, 4); uint16_t on = 0x0406, cmd; memcpy(pci3->cfg + 4, &on, 2);
    auto drv3 = new TinyGPUDriver; drv3->init(); drv3->Start_Impl(pci3); memcpy(pci3->cfg + 4, &on, 2);
    auto q = client(drv3, ents(arr({"org.tinygrad.tinygpu.driver2"}))); kern_return_t ra = call(q, QuiesceOnStop, {});
    drv3->Stop_Impl(pci3); g_cmdw_completes = -1; q->Stop_Impl(drv3); memcpy(&cmd, pci3->cfg + 4, 2);
    check(ra == 0 && pci3->closes == 1 && cmd == 0x0406 && g_cmdw_completes < 0,
          "driver stopped before its armed user client -> the user client's Stop finds no device and writes nothing to the closed one"); }
  // ---- the MI50 hook in Start: the bring-up runs for 1002:66a1 only (seen as its GetBARInfo(5)), on the opened device, its command register
  // written (IO, memory, bus master) only after MI50BarFix's state was read (finding 8); a bring-up that fails -> registered all the same, and
  // the user client serves RESET only (finding 15). Here it fails because no card is behind the device (every register reads all-ones: no
  // VBIOS); the bring-up on the virtual MI50, done and failed: t_dext.cpp D12/D13 ----
  for (auto [dev_id, tag] : std::vector<std::tuple<uint32_t, const char*>>{{0x66a11002, "MI50 without a card behind it, bring-up fails"},
         {0x73bf1002, "another AMD device"}, {0x66a110de, "device 66a1 of another vendor"}}) {
    auto p = new IOPCIDevice; memcpy(p->cfg, &dev_id, 4); auto d = new TinyGPUDriver; d->init();
    BARINFO5_CALLS = 0; BARINFO5_OPENS = 0; BARINFO5_CMD = 0; g_registers = 0; g_logs.clear(); STATE_QUERIES = 0; FIRST_CMDW_QUERIES = -1;
    kern_return_t r = d->Start_Impl(p); uint32_t v = 0; kern_return_t rc = d->CfgRead(0, 4, &v);
    bool mi50 = dev_id == 0x66a11002;
    uint16_t cmd; memcpy(&cmd, p->cfg + 4, 2);
    bool good = mi50 ? r == 0 && p->closes == 0 && d->GetPCI() == p && g_registers == 1 && d->MI50Refused() && logged("tinygpu: mi50: INITIALISATION FAILED")
                     : r == 0 && p->closes == 0 && d->GetPCI() == p && g_registers == 1 && rc == 0 && v == dev_id && !d->MI50Refused();
    bool hook = mi50 ? BARINFO5_CALLS == 1 && BARINFO5_OPENS == 1 && (BARINFO5_CMD & 7) == 0 && FIRST_CMDW_QUERIES >= 1 && (cmd & 7) == 7
                     : BARINFO5_CALLS == 0 && !logged("tinygpu: mi50:") && (cmd & 7) == 7;
    snprintf(m, sizeof m, "Start, %s: bring-up x%d (command %#x at GetBARInfo(5), written after %d kext state read(s), %#x after), Start -> %#x, "
             "registered %d, closed %d%s", tag, BARINFO5_CALLS, BARINFO5_CMD, FIRST_CMDW_QUERIES, cmd, r, g_registers, p->closes, mi50 ? ", refused" : "");
    check(good && hook, m);
    if (mi50) {   // the user client of a MI50 whose bring-up failed: RESET only
      auto u = client(d, ents(arr({"org.tinygrad.tinygpu.driver2"}))); uint64_t x = 0; IOMemoryDescriptor* md = nullptr; g_logs.clear();
      kern_return_t r1 = call(u, ReadCfg, {0, 4}, &x), r2 = u->CopyClientMemoryForType_Impl(5, nullptr, &md), r3 = call(u, Reset, {});
      snprintf(m, sizeof m, "MI50 bring-up failed: ReadCfg -> %#x, BAR map -> %#x, RESET -> %#x (the bring-up tried again: %s)", r1, r2, r3,
