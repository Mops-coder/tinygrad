  check(uc->CopyClientMemoryForType_Impl(0x8000, nullptr, &shared) == 0 && shared && uc->ivars->dmaCount == 20, "CopyClientMemoryForType(size) -> CreateDMA entry");
  { const uint64_t* seg = (const uint64_t*)(shared->mem.data() + IOVMPageSize); bool page0 = true;
    for (size_t i = 0; i < IOVMPageSize; i++) page0 = page0 && shared->mem[i] == 0;
    snprintf(m, sizeof m, "CreateDMA maps the segment list at offset %#llx, length %#llx, alignment %llu; list [%#llx, %#llx, 0, 0]; page 0 untouched",
             (unsigned long long)g_map_off, (unsigned long long)g_map_len, (unsigned long long)g_map_align, (unsigned long long)seg[0], (unsigned long long)seg[1]);
    check(g_map_off == IOVMPageSize && g_map_len == IOVMPageSize && g_map_align == 0 && seg[0] == uc->ivars->dmas[19].iova && seg[1] == 0x8000 &&
          seg[2] == 0 && seg[3] == 0 && page0, m); }
  { IOMemoryDescriptor* small = nullptr; int alive = g_cmd_alive; uint32_t n = uc->ivars->dmaCount;
    check(uc->CopyClientMemoryForType_Impl(IOVMPageSize, nullptr, &small) == kIOReturnBadArgument && !small && g_cmd_alive == alive && uc->ivars->dmaCount == n,
          "CopyClientMemoryForType(one page): no room for the list at the second page -> refused, its DMA command released, no entry"); }
  int rc = shared->rc; uint64_t siova = uc->ivars->dmas[19].iova;
  check(call(uc, ReleaseDMA, {siova}) == 0 && shared->rc == rc, "ReleaseDMA of that entry releases its DMA command, not the caller's buffer");
