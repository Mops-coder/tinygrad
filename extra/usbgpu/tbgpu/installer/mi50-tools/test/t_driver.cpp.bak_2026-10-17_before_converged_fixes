      check(r1 == kIOReturnNotReady && r2 == kIOReturnNotReady && !md && r3 == kIOReturnNotReady && logged("INITIALISATION FAILED after") && logged("(reset)"), m);
      // bug 1: the MI50 selector passes the gate and answers with the bring-up's failure reason (OP_SMU_VERSION 17: status 1, err = c->why)
      uint8_t rq[72] = {}; uint32_t op = 17; memcpy(rq, &op, sizeof(op));
      uint64_t so[2] = {}; IOUserClientMethodArguments a{nullptr, 0, so, 0, nullptr, nullptr};
      a.structureInput = OSData::withBytes(rq, sizeof(rq)); a.structureOutputMaximumSize = 1568;
      kern_return_t r4 = u->ExternalMethod(MI50, &a, nullptr, nullptr, nullptr); a.structureInput->release();
      int32_t st = -1; char why[505] = {};
      if (a.structureOutput) { const char* b = (const char*)a.structureOutput->getBytesNoCopy(); memcpy(&st, b, 4); memcpy(why, b + 8, 504); a.structureOutput->release(); }
      snprintf(m, sizeof m, "MI50 bring-up failed: the MI50 selector -> %#x, status %d, reason \"%s\" (the reason logged at the failure: %s)", r4, st, why,
               why[0] && logged(why) ? "yes" : "no");
      check(r4 == 0 && st == 1 && why[0] && logged(why), m);
      u->Stop_Impl(d);
    }
    d->Stop_Impl(p);
  }
  // ---- the MI50 selector on a card that is not a MI50: no request -> bad argument; a request -> unsupported (no MI50 state) ----
  { auto u = client(drv, ents(arr({"org.tinygrad.tinygpu.driver2"})));
    uint64_t o[2] = {}; IOUserClientMethodArguments a{nullptr, 0, o, 0, nullptr, nullptr};
    kern_return_t r1 = u->ExternalMethod(MI50, &a, nullptr, nullptr, nullptr);
    uint8_t req[72] = {}; a.structureInput = OSData::withBytes(req, sizeof(req)); a.structureOutputMaximumSize = 1568;
    kern_return_t r2 = u->ExternalMethod(MI50, &a, nullptr, nullptr, nullptr); a.structureInput->release();
    snprintf(m, sizeof m, "MI50 selector on another card: no request -> %#x, a request -> %#x, no reply set", r1, r2);
    check(r1 == kIOReturnBadArgument && r2 == kIOReturnUnsupported && !a.structureOutput, m);
    u->Stop_Impl(drv); }
  // ---- vendor fixes (2026-10-16) ----
  // init: IONewZero (IOFree's allocator, NULL on failure) instead of new; every init failure logged
  { auto d = new TinyGPUDriver; g_logs.clear(); g_alloc_fail_at = g_allocs + 1; bool ok = d->init(); g_alloc_fail_at = 0; TinyGPUDriver_IVars* iv = d->ivars; d->free();
    check(!ok && !iv && logged("tinygpu: init: no memory for the driver state"), "driver init, no memory for its state -> false, logged, free() after it is safe");
    auto d2 = new TinyGPUDriver; g_logs.clear(); g_init_fail = 1; bool ok2 = d2->init(); g_init_fail = 0;
    check(!ok2 && logged("tinygpu: init: IOService::init failed"), "driver init, IOService::init failing -> false, logged");
    auto u = new TinyGPUDriverUserClient; g_logs.clear(); g_alloc_fail_at = g_allocs + 1; bool ok3 = u->init(); g_alloc_fail_at = 0; u->free();
    auto u2 = new TinyGPUDriverUserClient; g_init_fail = 1; bool ok4 = u2->init(); g_init_fail = 0;
    check(!ok3 && !ok4 && logged("tinygpu: user client: no memory for its state") && logged("tinygpu: user client: IOUserClient::init failed"),
