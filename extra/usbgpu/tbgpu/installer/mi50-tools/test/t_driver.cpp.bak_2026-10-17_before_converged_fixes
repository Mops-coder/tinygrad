// t_driver.cpp - the TinyGPU driver's vendor paths: TinyGPUDriver.cpp and TinyGPUDriverUserClient.cpp compiled unchanged, in this translation
// unit, against the stand-in DriverKit headers (fake_driverkit/): the user-client access check, config bounds, PrepareDMA / ReleaseDMA
// bookkeeping, Stop teardown, every failure returned and logged, and the MI50 hook in Start (the bring-up on the virtual MI50 itself:
// t_dext.cpp D12/D13). No card is attached here (dk_card.hpp: CARD = nullptr): a device is its configuration space.
// Build/run: see mi50-tools/build_and_test.sh.
#include <functional>
#include <tuple>
#include "../../TinyGPUDriverExtension/TinyGPUDriver.cpp"
#include "../../TinyGPUDriverExtension/TinyGPUDriverUserClient.cpp"
#include "dk_card.hpp"
static bool logged(const char* s) { for (auto& l : g_logs) if (l.find(s) != std::string::npos) return true; return false; }
static int logged_n(const char* s) { int n = 0; for (auto& l : g_logs) n += l.find(s) != std::string::npos; return n; }

static int fails;
static void check(bool ok, const char* msg) { printf("%s %s\n", ok ? "ok  " : "FAIL", msg); fails += !ok; }
static OSDictionary* ents(OSObject* value) { auto d = new OSDictionary; if (value) d->d["com.apple.developer.driverkit.userclient-access"] = value; return d; }
static OSArray* arr(std::vector<const char*> v) { auto a = new OSArray; for (auto s : v) a->a.push_back(new OSString(s)); return a; }
static kern_return_t call(TinyGPUDriverUserClient* uc, uint64_t sel, std::vector<uint64_t> in, uint64_t* out = nullptr,
                          IOMemoryDescriptor* sin = nullptr, IOMemoryDescriptor* sout = nullptr) {
  uint64_t o[2] = {}; IOUserClientMethodArguments a{in.data(), (uint32_t)in.size(), o, 2, sin, sout};
  kern_return_t r = uc->ExternalMethod(sel, &a, nullptr, nullptr, nullptr); if (out) *out = o[0]; return r;
}
static TinyGPUDriverUserClient* client(TinyGPUDriver* drv, OSDictionary* e) {
  g_ents = e; g_ent_calls = 0; auto uc = new TinyGPUDriverUserClient; uc->init(); uc->Start_Impl(drv); return uc;
}

int main() { setvbuf(stdout, nullptr, _IONBF, 0);
  char m[256];
  // the vendor paths on an AMD GPU that is not the MI50 (Navi 21, 1002:73bf): an MI50 here would run the bring-up, which needs the card
  auto pci = new IOPCIDevice; uint32_t id = 0x73bf1002; memcpy(pci->cfg, &id, 4);
  auto drv = new TinyGPUDriver; drv->init(); drv->Start_Impl(pci);
  // ---- access check (R1-09 / R2-01) ----
  for (auto [what, e, ok] : std::vector<std::tuple<const char*, OSDictionary*, bool>>{
         {"no entitlements at all", nullptr, false}, {"entitlement absent", ents(nullptr), false},
         {"a boolean instead of the array", ents(new OSBoolean(true)), false}, {"array without this driver", ents(arr({"org.example.other"})), false},
         {"array listing org.tinygrad.tinygpu.driver2", ents(arr({"x", "org.tinygrad.tinygpu.driver2"})), true}}) {
    auto uc = client(drv, e); uint64_t v = 0; IOMemoryDescriptor* md = nullptr;
    kern_return_t r1 = call(uc, ReadCfg, {0, 4}, &v), r2 = call(uc, ReadCfg, {0, 4}, &v), r3 = uc->CopyClientMemoryForType_Impl(2, nullptr, &md);
    snprintf(m, sizeof m, "%s -> %s (ReadCfg %#x, BAR map %#x), entitlements read %d time(s)", what, ok ? "served" : "refused", r1, r3, g_ent_calls);
    check(ok ? (r1 == 0 && v == id && r2 == 0 && r3 == 0) : (r1 == kIOReturnNotPermitted && r2 == kIOReturnNotPermitted && r3 == kIOReturnNotPermitted && !md),
          m);
    check(g_ent_calls == 1, "  the decision is taken once per user client and cached");
  }
  auto uc = client(drv, ents(arr({"org.tinygrad.tinygpu.driver2"})));
  // ---- config bounds (R2-13) ----
  uint64_t v = 0;
  check(call(uc, ReadCfg, {0, 3}, &v) == kIOReturnBadArgument && call(uc, ReadCfg, {0xFFE, 4}, &v) == kIOReturnBadArgument &&
        call(uc, ReadCfg, {0xFFC, 4}, &v) == 0 && call(uc, ReadCfg, {0xFFFFFFFF, 1}, &v) == kIOReturnBadArgument, "ReadCfg: size 3, a dword past 0xFFF, offset -1 refused; 0xFFC/4 served");
  check(call(uc, WriteCfg, {0x40, 8, 1}) == kIOReturnBadArgument && call(uc, WriteCfg, {0x1000, 1, 1}) == kIOReturnBadArgument &&
        call(uc, WriteCfg, {0x40, 2, 0xBEEF}) == 0 && pci->cfg[0x40] == 0xEF && pci->cfg[0x41] == 0xBE, "WriteCfg: size 8 and offset 0x1000 refused; a word at 0x40 written");
  // ---- PrepareDMA / ReleaseDMA (R1-01 / R6-05) ----
  std::vector<uint64_t> iovas;
  auto in = new IOMemoryDescriptor; in->len = 0x10000; auto out = new IOMemoryDescriptor; out->len = 8192;
  for (int i = 0; i < 20; i++) {   // past the first growth of the 16-entry array
    call(uc, PrepareDMA, {}, nullptr, in, out); iovas.push_back(((uint64_t*)out->mem.data())[0]); }
  snprintf(m, sizeof m, "20 PrepareDMA -> 20 entries, 20 DMA commands alive, segment list [iova, len, 0, 0] written for each (first %#llx)", (unsigned long long)iovas[0]);
  check(uc->ivars->dmaCount == 20 && g_cmd_alive == 20 && ((uint64_t*)out->mem.data())[2] == 0, m);
  bool keys = true; for (size_t i = 0; i < 20; i++) keys = keys && uc->ivars->dmas[i].iova == iovas[i];
  check(keys, "each entry is keyed by its first segment address (the server's iova)");
  int c0 = g_completes;
  check(call(uc, ReleaseDMA, {iovas[5]}) == 0 && g_completes == c0 + 1 && g_cmd_alive == 19 && uc->ivars->dmaCount == 19,
        "ReleaseDMA(iova of #5) -> that command completed and released, 19 left");
  bool others = true; for (size_t i = 0; i < 20; i++) if (i != 5) { bool f = false; for (size_t j = 0; j < 19; j++) f = f || uc->ivars->dmas[j].iova == iovas[i]; others = others && f; }
  check(others, "every other entry is still present");
  check(call(uc, ReleaseDMA, {iovas[5]}) == kIOReturnNotFound && call(uc, ReleaseDMA, {0x1234}) == kIOReturnNotFound &&
