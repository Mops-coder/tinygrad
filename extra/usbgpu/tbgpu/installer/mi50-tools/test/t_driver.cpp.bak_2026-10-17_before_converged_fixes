  // a user client that outlives the driver's Stop (the device closed, ivars->pci = nullptr): BAR map, PrepareDMA, CreateDMA, Reset refused, not
  // dereferenced (stock MapBar / SetupDMA used the device pointer unchecked)
  { auto p = new IOPCIDevice; memcpy(p->cfg, &id, 4); auto d = new TinyGPUDriver; d->init(); d->Start_Impl(p);
