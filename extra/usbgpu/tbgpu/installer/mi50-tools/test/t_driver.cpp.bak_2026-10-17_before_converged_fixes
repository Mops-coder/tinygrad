  int c1 = g_completes, left = (int)uc->ivars->dmaCount;
  uc->Stop_Impl(drv);
  snprintf(m, sizeof m, "user client Stop -> %d remaining DMA commands completed and released (alive now %d)", left, g_cmd_alive);
  check(g_completes == c1 + left && g_cmd_alive == 0 && uc->ivars->dmaCount == 0, m);
