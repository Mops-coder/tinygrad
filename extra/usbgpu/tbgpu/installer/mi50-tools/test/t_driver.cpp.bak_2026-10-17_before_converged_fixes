  auto quiesce_case = [&](bool arm, uint16_t cmd0, const char* what, uint16_t want, bool written) {
    auto q = client(drv, ents(arr({"org.tinygrad.tinygpu.driver2"}))); memcpy(pci->cfg + 4, &cmd0, 2);
    kern_return_t ra = arm ? call(q, QuiesceOnStop, {}) : 0;
    for (int i = 0; i < 2; i++) call(q, PrepareDMA, {}, nullptr, in, out);
    int c0 = g_completes; g_cmdw_completes = -1; q->Stop_Impl(drv); uint16_t cmd; memcpy(&cmd, pci->cfg + 4, 2);
