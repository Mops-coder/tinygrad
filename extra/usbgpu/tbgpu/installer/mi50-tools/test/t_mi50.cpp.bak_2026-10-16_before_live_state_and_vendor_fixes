  // ================= T0: the driver's fixed boot layout = AM's init_sw requests through the reference TLSFAllocator =================
  { // AM's requests in order (amdev.py init_sw, ip.py AM_GMC/AM_IH/AM_PSP/AM_SMU init_sw), each palloc'd: size rounded up to 4 KiB
    const uint64_t req[mi50::MI50Device::B_COUNT][2] = {{0x1000, 0x1000}, {0x1000, 0x1000}, {0x1000, 0x1000},
      {256 << 10, 0x1000}, {0x1000, 0x1000}, {256 << 10, 0x1000}, {0x1000, 0x1000},
      {1 << 20, 1 << 20}, {0x1000, 0x1000}, {0x1000, 0x1000}, {0x10000, 0x1000}, {0x4000, 0x4000}, {0x1300000, 1 << 20},
      {sizeof(PPTable_t), 0x1000}, {sizeof(Watermarks_t), 0x1000}, {0x19000, 0x1000}, {sizeof(OverDriveTable_t), 0x1000}, {sizeof(SmuMetrics_t), 0x1000},
      {sizeof(DpmActivityMonitorCoeffInt_t), 0x1000}};
    const mi50::MI50Device::BootBuf *bl = mi50::MI50Device::boot_layout();
    Tlsf t; t.init(32ull << 20, 0); int bad = 0; std::string first;
    for (int i = 0; i < mi50::MI50Device::B_COUNT; i++) {
      uint64_t a = ~0ull; bool ok = t.alloc(round_up(req[i][0], 0x1000), req[i][1], &a);
      if (!(ok && a == bl[i].addr && bl[i].size == req[i][0] && bl[i].align == req[i][1]) && !bad++)
        first = " first: #" + std::to_string(i) + " reference " + hx(a) + " driver " + hx(bl[i].addr);
    }
    check(bad == 0, "T0: every one of the driver's " + std::to_string((int)mi50::MI50Device::B_COUNT) + " boot buffers has the size, alignment and address "
          "the reference allocator gives AM's request" + first); }

  // ================= T: the reference TLSF allocator itself, against hand traces =================
  { Tlsf t; uint64_t a = 0;
    t.init(0, 0);
    check(!t.alloc(16, 16, &a), "T1: an empty region allocates nothing");
    std::vector<std::pair<uint64_t, uint64_t>> got;   // (address, size)
    const uint64_t base = 0x40000, total = 0x10000;
    bool ok = true; t.init(total, base);
    const uint64_t req[][2] = {{0x1000, 0x1000}, {0x100, 0x1000}, {1, 1}, {1, 1}, {0x3000, 0x4000}, {0x20, 0x10}};
    for (auto &q : req) { ok = ok && t.alloc(q[0], q[1], &a) && (a - base) % q[1] == 0; got.push_back({a, std::max<uint64_t>(q[0], 16)}); }
    while (t.alloc(0x400, 0x400, &a)) got.push_back({a, 0x400});
    for (size_t i = 0; i < got.size(); i++) {
      ok = ok && got[i].first >= base && got[i].first + got[i].second <= base + total;
      for (size_t j = 0; j < i; j++) ok = ok && (got[i].first + got[i].second <= got[j].first || got[j].first + got[j].second <= got[i].first);
    }
    check(ok && got.size() > 10, "T2: TLSF allocations aligned, inside the region, never overlapping, until the region is used up (" + std::to_string(got.size()) + ")");
    int n = 0; t.init(total, 0);
    while (t.alloc(16, 1, &a)) n++;
    check(n == Tlsf::MAXB - 1, "T3: 16-byte allocations stop when the 128 block records are used (" + std::to_string(n) + " made)");
    t.init(total, 0); bool seq_ok = true;
    for (int i = 0; i < 125; i++) seq_ok = seq_ok && t.alloc(16, 1, &a);   // 126 records, 2 spare; the free rest starts at 2000 (not 32-aligned)
    uint64_t x1 = 0, x2 = 0;
    bool aligned = t.alloc(16, 32, &x1);   // the alignment split and the size split take the last 2 records: 2016, leaving [2000, 2016) free
    bool refused = !t.alloc(16, 32, &x2);   // 2032 needs an alignment split: no record left, nothing changed
    bool frag = t.alloc(16, 1, &x2);        // the 16-byte fragment fits exactly: no split needed
    check(seq_ok && aligned && x1 == 2016 && refused && frag && x2 == 2000,
          "T3b: an aligned allocation without a free record for its split is refused with the allocator unchanged (fragment 2000 still served)");
    // T4: a sequence traced by hand through tinygrad's TLSFAllocator.alloc (support/memory.py) on 128 KiB
    t.init(0x20000, 0); uint64_t r[5] = {}; bool okr[5];
    okr[0] = t.alloc(0x7800, 1, &r[0]);       // block 0 (l1 18) split: [0, 0x7800) taken, [0x7800, 0x20000) free (l1 17, l2 8)
    okr[1] = t.alloc(0x100, 0x10000, &r[1]);  // bucket (17, 1): align split at 0x10000 leaves [0x7800, 0x10000) (16, 1), size split leaves 0xFF00 (16, 15)
    okr[2] = t.alloc(0xF000, 1, &r[2]);       // bucket (16, 14) -> the 0xFF00 block at 0x10100
    okr[3] = t.alloc(0x9000, 1, &r[3]);       // bucket (16, 2): level 16 only has (16, 1) -> nothing larger anywhere: MemoryError
    okr[4] = t.alloc(0x8800, 1, &r[4]);       // bucket (16, 1): the 0x8800 block, an exact fit (no split)
    check(okr[0] && r[0] == 0 && okr[1] && r[1] == 0x10000 && okr[2] && r[2] == 0x10100 && !okr[3] && okr[4] && r[4] == 0x7800,
          "T4: hand-traced TLSF sequence: 0, 0x10000, 0x10100, MemoryError, 0x7800 (exact fit): " + hx(r[0]) + " " + hx(r[1]) + " " + hx(r[2]) + " " + hx(r[4]));
    // T5: two free 16-byte fragments in one bucket (storage[5][0]) are served oldest first, like the reference's list[0]
    t.init(0x1000, 0); uint64_t f[5] = {};
    bool okf = t.alloc(16, 1, &f[0]) && t.alloc(16, 32, &f[1]) && t.alloc(16, 64, &f[2]);   // fragments [16, 32) then [48, 64)
    okf = okf && t.alloc(16, 1, &f[3]) && t.alloc(16, 1, &f[4]);
    check(okf && f[0] == 0 && f[1] == 32 && f[2] == 64 && f[3] == 16 && f[4] == 48,
          "T5: fragments of one bucket go out oldest first: " + hx(f[3]) + " then " + hx(f[4]));
    // T6: a younger fragment in a lower record ([80, 96) re-inserted into record 3 after [48, 64) went into record 5): still oldest first
    t.init(0x1000, 0); uint64_t g[7] = {};
    bool okg = t.alloc(16, 1, &g[0]) && t.alloc(16, 64, &g[1]) && t.alloc(16, 32, &g[2]) && t.alloc(16, 32, &g[3]) &&
               t.alloc(16, 1, &g[4]) && t.alloc(16, 1, &g[5]) && t.alloc(16, 1, &g[6]);
    check(okg && g[0] == 0 && g[1] == 64 && g[2] == 32 && g[3] == 96 && g[4] == 16 && g[5] == 48 && g[6] == 80,
          "T6: three fragments of one bucket, records out of age order: served 16, 48, 80: " + hx(g[4]) + " " + hx(g[5]) + " " + hx(g[6])); }

  printf("\n%d ok / %d FAIL\n", nok, nfail);
  return nfail ? 1 : 0;
}
