#!/bin/zsh
# MI50 support for the TinyGPU driver: regenerate its tables from the primary sources, compile the driver code, run the offline tests.
#   build_and_test.sh <linux drivers/gpu/drm/amd> <tinygrad autogen/am/regs.py> <vega20 firmware dir> <V420.rom> <build dir>
set -euo pipefail
LINUX=$1 REGS=$2 FW=$3 ROM=$4 OUT=$5
HERE=${0:A:h}
MI50=$HERE/../TinyGPUDriverExtension/MI50
mkdir -p $OUT
CXX=(clang++ -std=gnu++17 -Wall -Wextra -Werror)
$CXX -O1 -o $OUT/mi50_gen $HERE/mi50_gen.cpp
$OUT/mi50_gen $LINUX $REGS $FW $MI50
# the driver's code, as the dext compiles it (no exceptions, no RTTI) and with the sanitizers for the tests
$CXX -fno-exceptions -fno-rtti -Wno-unused-parameter -fsyntax-only $MI50/MI50Device.cpp
$CXX -g -O1 -fsanitize=address,undefined -fno-sanitize-recover=all -Wno-unused-parameter -o $OUT/t_mi50 $HERE/test/t_mi50.cpp $MI50/MI50Device.cpp
$OUT/t_mi50 $FW $ROM
